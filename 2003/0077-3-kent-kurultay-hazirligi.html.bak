    border: 1px solid #b9a36a;
    border-radius: 6px;

    background: transparent;
    color: #333;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 15px;

    cursor: pointer;

    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.print-button:hover {
    background: #b9a36a;
    color: white;
    border-color: #b9a36a;
}

.print-icon {
    font-size: 16px;
    line-height: 1;
}


/* ============================================================
   PRINT VERSION
   ============================================================ */

@media print {

    /* Remove everything that should not appear on paper */

    .print-button-container,
    nav,
    footer,
    .top-nav,
    .article-navigation,
    .article-nav,
    .site-header {
        display: none !important;
    }


    /* White page background */

    html,
