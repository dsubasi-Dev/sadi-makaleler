    font-size: 15px;

    cursor: pointer;

    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.print-button:hover {
    background: #b9a36a;
    color: white;
    border-color: #b9a36a;
}

.print-icon {
    font-size: 16px;
