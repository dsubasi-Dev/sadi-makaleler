    border-color: #b9a36a;
}

.print-icon {
    font-size: 16px;
    line-height: 1;
}


/* ============================================================
   PRINT VERSION
   ============================================================ */

@media print {

    /* Remove everything that should not appear on paper */

    .print-button-container,
