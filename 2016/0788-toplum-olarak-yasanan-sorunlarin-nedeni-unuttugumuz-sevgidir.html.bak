        max-width: none !important;

        margin: 0 !important;
        padding: 0 !important;

        border: none !important;
        background: white !important;
    }


    /* Article title */

    h1,
    h2 {
        color: black !important;
    }


    /* Article text */

    p {
        color: black !important;
    }


    /* Links should print as normal text */

    a {
        color: black !important;
        text-decoration: none !important;
    }


    /* Prevent awkward page breaks */

    h1,
    h2,
    h3 {
        break-after: avoid;
    }

    p {
        orphans: 3;
        widows: 3;
    }
}

